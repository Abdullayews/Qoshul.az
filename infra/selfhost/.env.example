############
# Qoshul.az — self-hosted Supabase konfiqurasiyası (M5, D-086)
#
# İSTİFADƏ (ilk quraşdırma):
#   cp .env.example .env
#   sh generate-keys.sh --update-env     # bütün sirləri avtomatik yaradır
#   → SONRA 🔶 ilə işarələnmiş dəyərləri əl ilə doldur (aşağıda).
#
# 🔶 = istifadəçidən gözlənilən dəyər (D-079 placeholder prinsipi).
# Mənbə: supabase/supabase@396358c docker/.env.example — uyğunlaşdırılıb.
############

############
# Secrets — generate-keys.sh --update-env avtomatik doldurur
############

# Postgres
POSTGRES_PASSWORD=PLACEHOLDER_RUN_GENERATE_KEYS

# Legacy symmetric HS256 açarı
JWT_SECRET=PLACEHOLDER_RUN_GENERATE_KEYS

# Legacy API açarları (HS256 JWT) — JWT_SECRET ilə imzalanır
ANON_KEY=PLACEHOLDER_RUN_GENERATE_KEYS
SERVICE_ROLE_KEY=PLACEHOLDER_RUN_GENERATE_KEYS

# Asimmetrik açarlar (ES256) və opaque açarlar — İSTİFADƏ OLUNMUR (legacy rejim)
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JWT_KEYS=
JWT_JWKS=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=

# Dashboard girişi (studio profili) — generate-keys.sh parole doldurur
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=PLACEHOLDER_RUN_GENERATE_KEYS

# Realtime/Supavisor şifrələmə açarları
SECRET_KEY_BASE=PLACEHOLDER_RUN_GENERATE_KEYS
REALTIME_DB_ENC_KEY=PLACEHOLDER_RUN_GENERATE_KEYS
VAULT_ENC_KEY=PLACEHOLDER_RUN_GENERATE_KEYS
PG_META_CRYPTO_KEY=PLACEHOLDER_RUN_GENERATE_KEYS

# Storage S3 protokol açarları (storage profili)
S3_PROTOCOL_ACCESS_KEY_ID=PLACEHOLDER_RUN_GENERATE_KEYS
S3_PROTOCOL_ACCESS_KEY_SECRET=PLACEHOLDER_RUN_GENERATE_KEYS


############
# URL-lər — 🔶 DOMENİ ÖZ DƏYƏRİNİLƏ DƏYİŞ
############

# Xarici API ünvanı (tətbiq buna qoşulur — SUPABASE_URL eyni olur)
SUPABASE_PUBLIC_URL=https://supabase.qoshul.az

# Auth xidmətinin xarici URL-i (OAuth callback / email linklər üçün)
API_EXTERNAL_URL=https://supabase.qoshul.az/auth/v1

# 🔶 Caddy TLS domeni (edge profili) — DNS A qeydi serverə yönəlməlidir
PROXY_DOMAIN=supabase.qoshul.az


############
# Database
############

POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432


############
# Pooler (supavisor — yalnız `pooler` profili) 🔶 tenant ID doldur
############

POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=PLACEHOLDER_tenant_id
POOLER_DB_POOL_SIZE=5


############
# Studio (dashboard profili)
############

STUDIO_DEFAULT_ORGANIZATION=Qoshul.az
STUDIO_DEFAULT_PROJECT=Qoshul
# AI köməkçi üçün (istəyə bağlı)
OPENAI_API_KEY=


############
# Auth (gotrue)
############

# 🔶 Tətbiqin əsas ünvanı (email linkləri bura qayıdır)
SITE_URL=https://qoshul.az
ADDITIONAL_REDIRECT_URLS=

JWT_EXPIRY=3600
DISABLE_SIGNUP=false

MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

## Email auth — MVP: autoconfirm AÇIQ (SMTP yoxdur; real poçt gələndə
## ENABLE_EMAIL_AUTOCONFIRM=false + SMTP bölməsini doldur)
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true

## 🔶 SMTP (real email təsdiqi aktiv olanda)
SMTP_ADMIN_EMAIL=admin@qoshul.az
SMTP_HOST=
SMTP_PORT=2500
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Qoshul.az

ENABLE_ANONYMOUS_USERS=false

## Phone auth — MVP-də bağlı (SMS provayder yoxdur)
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=true


############
# Storage (storage profili)
############

GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=stub


############
# Functions (functions profili)
############

FUNCTIONS_VERIFY_JWT=false
# 2 OCPU / 12 GB VM üçün 512m kifayətdir (rəsmi default 2g — D-085)
FUNCTIONS_MEMORY_LIMIT=512m


############
# API — PostgREST
############

PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public


############
# API gateway (envoy)
############

# Yalnız localhost — xarici trafik Caddy TLS-dən keçir (D-085)
API_GW_HTTP_PORT=8000


############
# imgproxy (storage profili)
############

IMGPROXY_AUTO_WEBP=true
