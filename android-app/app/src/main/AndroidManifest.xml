<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- D-129 (direktiv 2026-11-11: „istifadəçidən lokasiya, şəkil, saxlama
         icazələri al“): runtime icazələr —
         - lokasiya: yaxınlıq axtarışı / xəritədə ətraf (coarse+fine);
         - şəkil: qalereya (API 33+ READ_MEDIA_IMAGES);
         - saxlama: API ≤32 üçün əvəzedici READ_EXTERNAL_STORAGE
           (API 33-də qalereya icazəsi ilə əvəz olunur — maxSdkVersion=32);
         - bildirişlər: push bildirişləri (API 33+ runtime). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".QoshulApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Qoshul">
        <!-- D-108/D-109: Google Maps SDK açarı. Dəyəri gradle
             manifestPlaceholder MAPS_API_KEY-dan gəlir (local.properties
             VƏ YA env/CI secret: MAPS_API_KEY=AIza…). Açar olanda xəritə
             ƏSAS backend kimi Google işləyir; açarsızda meta-data boş
             qalır və MapScreen maplibre fallback seçir — Google xəritəsi
             kompozisiya olunmur, zərərsizdir. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Qoshul">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
