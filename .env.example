# =====================================================================
# Qoshul.az — mühit dəyişənləri (NÜMUNƏ)
# Qayda 3: real dəyərlər yalnız .env-də (gitignore-da) və ya CI
# secrets-də saxlanılır. Heç vaxt koda yazılmır.
# Lokal dev üçün minimum: POSTGRES_PASSWORD + REDIS_PASSWORD.
# =====================================================================

# --- App ---
NODE_ENV=development
PORT=4000
PUBLIC_API_URL=http://localhost:4000

# --- VM topologiyası (Oracle A1 — production) ---
# VM1: Caddy + NestJS + Redis (public 80/443)
# VM2: PostgreSQL + PostGIS (private; 5432 YALNIZ VM1-dən — runbook.md §2)
# VM1_PUBLIC_IP=
# VM2_PRIVATE_IP=
# PG_BIND_IP=            # VM2 compose 5432-ni bu private IP-yə bind edir

# --- PostgreSQL (VM2; lokal dev-də 127.0.0.1) ---
POSTGRES_USER=qoshul
POSTGRES_PASSWORD=
POSTGRES_DB=qoshul
# nümunə (VM1-dən): postgresql://qoshul:SIFRE@VM2_PRIVATE_IP:5432/qoshul
DATABASE_URL=
# VM2 block volume mount nöqtəsi (yalnız VM2-də lazım)
PGDATA_VOLUME=/mnt/qoshul-pgdata

# --- Redis (VM1) ---
REDIS_PASSWORD=
# VM1 (compose daxili): redis://:SIFRE@redis:6379
# lokal dev: redis://localhost:6379
REDIS_URL=

# --- JWT (m3 — auth modulu) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- OAuth (m3) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_CLIENT_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=./keys/apple.p8

# --- SMTP — email təsdiqi (m3) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Qoshul <no-reply@qoshul.az>"

# --- SMS OTP (opsional — sərt rate limit; m3) ---
SMS_ENABLED=false
SMS_PROVIDER_API_KEY=
SMS_RATE_LIMIT_PER_HOUR=3

# --- Oracle Cloud Object Storage — media (m4+) + backup (m10) ---
# S3 Compatibility API (rəsmi dəstək — decisions.md D-018):
#   endpoint = https://{OCI_NAMESPACE}.compat.objectstorage.{OCI_REGION}.oraclecloud.com
# Açarlar: OCI Console → Identity → User → Customer Secret Keys
OCI_REGION=eu-frankfurt-1
OCI_NAMESPACE=
OCI_ACCESS_KEY_ID=
OCI_SECRET_ACCESS_KEY=
OCI_MEDIA_BUCKET=qoshul-media
OCI_BACKUP_BUCKET=qoshul-backup
# Media publik oxunuş URL-i (tətbiqə bu prefixed URL gedir):
OCI_MEDIA_PUBLIC_URL=https://objectstorage.eu-frankfurt-1.oraclecloud.com/n/NAMESPACE/b/qoshul-media/o
# Always Free limitlər: 20GB (Standard+IA+Archive cəmi) · 50K API request/ay
# · 10TB egress/ay — decisions.md D-018. Yaddaş büdcəsi: media ~15GB, backup ~3GB.

# --- FCM — push (m6) ---
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_PATH=./keys/fcm-service-account.json

# --- AI köməkçi — açar YALNIZ serverdə (m9) ---
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# --- Caddy (VM1) ---
CADDY_DOMAIN=api.qoshul.az
CADDY_ACME_EMAIL=admin@qoshul.az

# --- Observability (m10) ---
# Birincil: Prometheus + Grafana VM1-də (self-hosted). Sentry opsional xarici (D-021).
SENTRY_DSN_BACKEND=
SENTRY_DSN_FLUTTER=

# --- Docker imajları (m10 CI-dən gəlir; GHCR adları lowercase olmalıdır) ---
BACKEND_IMAGE=ghcr.io/abdullayews/qoshul-backend:latest
