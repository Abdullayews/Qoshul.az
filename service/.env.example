############
# Qoshul.az — M4 mikroservisi (service/) konfiqurasiyası (D-082)
#
# İSTİFADƏ:
#   cp service/.env.example service/.env   # sonra doldurun
#   cargo run --release                    # .env-i envsubst/dotenvsiz oxumaq
#   üçün: set -a; source service/.env; set +a; cargo run --release
#
# Prinsip (D-079): BÜTÜN dəyərlər PLACEHOLDER ilə başlayır — service
# PLACEHOLDER halında DEQRAD işləyir (crash YOX): /health və admin API
# sxematik cavab verir, FCM söndürülür, Supabase əməliyyatları xəta
# qaytarır. Real dəyərlər YALNIZ lokal .env / deploy mühitində olur.
############

# HTTP portu (container-da 0.0.0.0:8080; CI health yoxlaması 9911 işlədir)
PORT=8080

# Self-host Supabase URL-i (infra/selfhost/README.md §4)
SUPABASE_URL=PLACEHOLDER

# service_role açarı — YALNIZ mikroservisdə istifadə olunur,
# tətbiqə heç vaxt düşmür (RLS-i bypass edir)
SUPABASE_SERVICE_ROLE_KEY=PLACEHOLDER

# FCM service-account JSON (push bildirişlər; PLACEHOLDER → push söndürülür)
FCM_SERVICE_ACCOUNT_JSON=PLACEHOLDER

# Jobların işə düşmə periodu, saniyə (cron əvəzinə interval — hər tur idempotent)
JOBS_INTERVAL_SECS=60

# Admin panel API tokeni (X-Admin-Token; PLACEHOLDER → panel qapalı)
ADMIN_TOKEN=PLACEHOLDER
